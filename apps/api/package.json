    "db": "workspace:*",
    "drizzle-orm": "catalog:",
    "errore": "catalog:",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "cf": "^1.0.0-rc.2",
