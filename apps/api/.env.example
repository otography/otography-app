# cp .env.example .env で作り、値を入れる。.env は Git に入れない。
# cf dev（Cloudflare の Vite プラグイン）は、この .env の値を Worker のシークレットとして読み込む。

# Better Auth がセッションの署名などに使う鍵。openssl rand -base64 32 で作る
BETTER_AUTH_SECRET=

# Google Cloud Console で作った OAuth クライアント（ウェブアプリケーション）
# 承認済みのリダイレクト URI：http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Developer の Keys で「Media Services (MusicKit, ShazamKit, Apple Music Feed)」を有効にして作った鍵
# APPLE_TEAM_ID はメンバーシップ画面の Team ID、APPLE_KEY_ID はその鍵の Key ID
# APPLE_MUSIC_PRIVATE_KEY は .p8 の中身。改行を含むので "..." で囲む
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=

# OAUTH_PROXY_SECRET はローカルでは設定しない（本番と Preview だけで使う）

# ローカルは turso dev --db-file local.db（認証トークン不要）
TURSO_DATABASE_URL=http://127.0.0.1:8080
TURSO_AUTH_TOKEN=

# 感想記述支援の判断モデル設定（すべて任意。未設定時は Workers AI の clef-flash と初期閾値を使う）
# DRAFT_ASSIST_PROVIDER=clef-flash | pplx-decider
DRAFT_ASSIST_PROVIDER=clef-flash
DRAFT_ASSIST_MODEL=
DRAFT_ASSIST_API_URL=
DRAFT_ASSIST_API_KEY=
DRAFT_ASSIST_CHOICE_CONFIDENCE=
DRAFT_ASSIST_ELEMENT_PRESENT=
DRAFT_ASSIST_ELEMENT_ABSENT=
