{
  "name": "otography-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run website#dev",
    "prepare": "vp config",
    "knip": "knip",
    "similarity": "similarity-ts apps packages --exclude '**/*.gen.ts' --threshold 0.85 --min-tokens 25 --types --experimental-overlap",
    "similarity:ci": "similarity-ts apps packages --exclude '**/*.gen.ts' --threshold 0.95 --min-tokens 25 --types --fail-on-duplicates"
  },
  "devDependencies": {
    "@stylexjs/eslint-plugin": "catalog:",
    "knip": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
